# Referans malzemeler ve büyük dosyalar repoya girmez
# (üçüncü taraf PDF'ler telifli; OCCT SDK 258 MB, GitHub dosya sınırı 100 MB)
/*.zip
/*.pdf
/*.docx
~$*

# Gerçek kart STEP dosyaları (şirket tasarımları) asla repoya girmez.
# Yalnızca web/samples altındaki üretilmiş örnekler izinli.
*.step
*.stp
*.STEP
*.STP
!/web/samples/*.step
/yerel-testler/

# Yerel araç ayarları
.claude/
.vscode/

